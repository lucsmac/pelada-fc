{
  "name": "@peladafc/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Schemas Zod e DTOs compartilhados entre web e api",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
